# Environment: development, test, or production.
APP_ENV=development

# PostgreSQL is recommended outside local development.
DATABASE_URL=sqlite:///backend/fintech_agent.db
SEED_DEMO_DATA=true

# local = chatbot SQLite demo data.
# corebank = Java Spring Boot banking app is the account/transaction/risk source.
BANKING_DATA_SOURCE=local
COREBANK_BASE_URL=http://127.0.0.1:8080
COREBANK_TIMEOUT_SECONDS=8
COREBANK_FALLBACK_TO_LOCAL=false
COREBANK_SERVICE_TOKEN=local-corebank-service-token-change-me
COREBANK_USER_U001_EMAIL=rahul@example.com
COREBANK_USER_U002_EMAIL=amit@example.com
COREBANK_USER_U003_EMAIL=neha@example.com

# Used only by scripts/seed_corebank_demo.py, never by the AI backend.
COREBANK_SEED_ADMIN_EMAIL=demo.admin@corebank.local
COREBANK_SEED_ADMIN_PASSWORD=password123
COREBANK_SEED_ADMIN_CODE=admin123
COREBANK_SEED_USER_U001_PASSWORD=password123
COREBANK_SEED_USER_U002_PASSWORD=password123
COREBANK_SEED_USER_U003_PASSWORD=password123

# development issues local demo tokens; production must use jwt.
AUTH_MODE=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
ACCESS_TOKEN_MINUTES=60

# local, openai, deepseek, ollama, or another OpenAI-compatible endpoint.
# local = deterministic in-app router, no API calls.
# ollama = local LLM through http://127.0.0.1:11434/v1 by default.
LLM_PROVIDER=local
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=12
LLM_POLISH_RESPONSES=true

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
FINTECH_API_URL=http://127.0.0.1:8000
